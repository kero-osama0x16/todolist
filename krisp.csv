1.44,41.6,41.92,42.08,42.48,43.12,43.839999999999996,44.16,44.4,44.72,45.12,45.519999999999996,45.6,45.76,45.92,46.08,46.4,46.72,46.96,47.12,47.68,48.48,48.8,49.519999999999996,49.68,50.32]}},{""speakerIndex"":1,""id"":7,""speech"":{""start"":51.68,""end"":55.28,""text"":""Thank you so much. I'm so excited to go and try this out."",""confidence"":[1,0.999,0.999,0.999,0.991,0.997,0.999,1,0.998,0.994,0.999,0.999,0.995],""wordStartTime"":[51.68,51.92,52.31999999999999,52.64,53.03999999999999,53.36,53.67999999999999,54.16,54.239999999999995,54.480000000000004,54.72,55.03999999999999,55.2]}},{""speakerIndex"":2,""id"":8,""speech"":{""start"":56.08,""end"":61.760000000000005,""text"":""You're welcome. Just make sure that Krisp is up and running in your next meeting and see it for yourself."",""confidence"":[0.97,0.998,0.997,1,1,0.997,0.782,0.97,1,0.999,0.999,0.995,0.997,1,1,0.998,0.635,0.591,0.999,0.999],""wordStartTime"":[56.08,56.480000000000004,57.120000000000005,57.28,57.519999999999996,57.67999999999999,57.92,58.480000000000004,58.64,58.8,58.879999999999995,59.44,59.599999999999994,59.760000000000005,60.08,60.56,60.879999999999995,61.120000000000005,61.36,61.519999999999996]}}],""eng_confidence"":96.15384615384616,""meta"":{""version"":2,""eng_confidence"":96.15384615384616},""content"":""[{\""speakerIndex\"":2,\""id\"":1,\""speech\"":{\""start\"":12.027,\""end\"":12.987,\""text\"":\""Hello.\"",\""confidence\"":[0.999],\""wordStartTime\"":[12.027]}},{\""speakerIndex\"":1,\""id\"":2,\""speech\"":{\""start\"":12.987,\""end\"":14.267,\""text\"":\""Hi.\"",\""confidence\"":[0.964],\""wordStartTime\"":[12.987]}},{\""speakerIndex\"":2,\""id\"":2,\""speech\"":{\""start\"":14.267,\""end\"":18.507,\""text\"":\""It's great that you're here. I'll now tell you about the important features of Krisp.\"",\""confidence\"":[0.997,1,0.999,0.98,0.999,0.978,0.973,1,1,1,0.999,0.999,0.964,0.999,0.9],\""wordStartTime\"":[14.267,14.587,14.827,14.987,15.307,15.787,16.107,16.347,16.587,16.827,17.067,17.307,17.707,18.187,18.347]}},{\""speakerIndex\"":1,\""id\"":1,\""speech\"":{\""start\"":19.467,\""end\"":22.827,\""text\"":\""Wow, I'm so excited. Tell me everything, you know.\"",\""confidence\"":[0.906,0.982,0.999,0.999,1,0.999,0.999,1,1],\""wordStartTime\"":[19.467,20.027,20.347,20.747,21.547,21.867,22.107,22.507,22.747]}},{\""speakerIndex\"":2,\""id\"":4,\""speech\"":{\""start\"":24.667,\""end\"":44.027,\""text\"":\""Well, Krisp automatically transcribes and records your meetings and then uses AI to create a short summary that you can share with your colleagues immediately after this meeting so you no longer have to spend hours crafting that follow up email with meeting notes and action items. Everything is done automatically.\"",\""confidence\"":[0.991,0.91,0.999,0.942,0.998,0.889,0.997,0.978,0.999,0.999,0.979,0.849,0.998,0.998,0.996,0.999,0.998,0.995,0.999,0.998,0.999,0.999,0.996,0.565,0.999,0.999,0.987,0.803,1,0.999,0.999,1,0.999,1,0.997,0.998,0.998,0.994,0.999,0.934,0.952,0.933,0.973,0.991,0.915,0.997,0.912,0.999,0.995,0.999,0.997],\""wordStartTime\"":[24.667,25.307,25.787,26.587,27.387,27.707,28.107,28.347,28.827,28.987,29.227,29.707,30.347,30.427,30.747,30.987,31.307,31.947,32.107,32.267,32.507,32.747,32.907,33.147,33.707,34.427,34.667,34.907,35.867,36.587,37.147,37.307,37.707,37.947,38.107,38.507,38.987,39.547,39.707,40.027,40.267,40.587,40.827,41.227,41.547,41.627,41.947,42.587,42.907,43.147,43.387]}},{\""speakerIndex\"":1,\""id\"":5,\""speech\"":{\""start\"":45.147,\""end\"":51.867,\""text\"":\""This is really great. I want to use it right now. But does it what, with my calling app?\"",\""confidence\"":[0.998,0.999,0.999,0.999,1,0.815,0.803,0.999,0.999,0.998,1,0.998,0.975,0.983,0.77,0.955,0.998,0.963,0.814],\""wordStartTime\"":[45.147,45.307,45.627,45.947,46.347,46.667,46.827,46.987,47.227,47.467,47.787,49.467,50.187,50.427,50.587,50.747,51.067,51.227,51.707]}},{\""speakerIndex\"":2,\""id\"":6,\""speech\"":{\""start\"":53.147,\""end\"":62.667,\""text\"":\""Yes, and that's the best part. Krisp works with any calling app, so you can use it across all the calling applications and centralize your meetinging knowledge.\"",\""confidence\"":[0.991,0.989,0.993,0.999,1,0.999,0.279,0.997,0.999,0.997,0.375,0.975,0.997,0.997,0.994,1,0.998,1,0.999,0.999,0.922,0.997,0.999,0.997,0.997,0.655,0.988],\""wordStartTime\"":[53.147,53.467,53.627,53.947,54.107,54.507,55.147,55.867,56.187,56.427,56.747,57.147,57.547,57.627,57.787,57.947,58.107,58.427,58.747,58.987,59.147,59.707,60.507,60.827,61.547,61.707,62.347]}},{\""speakerIndex\"":1,\""id\"":7,\""speech\"":{\""start\"":63.707,\""end\"":67.307,\""text\"":\""Thank you so much. I'm so excited to go and try this out.\"",\""confidence\"":[1,0.999,0.999,0.999,0.991,0.997,0.999,1,0.998,0.994,0.999,0.999,0.995],\""wordStartTime\"":[63.707,63.947,64.347,64.667,65.067,65.387,65.707,66.187,66.267,66.507,66.747,67.067,67.227]}},{\""speakerIndex\"":2,\""id\"":8,\""speech\"":{\""start\"":68.107,\""end\"":73.787,\""text\"":\""You're welcome. Just make sure that Krisp is up and running in your next meeting and see it for yourself.\"",\""confidence\"":[0.97,0.998,0.997,1,1,0.997,0.782,0.97,1,0.999,0.999,0.995,0.997,1,1,0.998,0.635,0.591,0.999,0.999],\""wordStartTime\"":[68.107,68.507,69.147,69.307,69.547,69.707,69.947,70.507,70.667,70.827,70.907,71.467,71.627,71.787,72.107,72.587,72.907,73.147,73.387,73.547]}}]""}}],""associated_to"":[],""$version"":1,""content"":{""updated_at"":""2026-10-07T11:07:25+00:00"",""created_at"":""2026-10-07T11:07:20+00:00"",""workspace_id"":7114804,""user_id"":15395451}}],""associated_to"":[],""$version"":7,""content"":{""stream_id"":null,""updated_at"":""2026-10-07T11:12:35+00:00"",""status"":""ready"",""duration"":75,""name"":""Krisp Product Overview and Features Sync"",""call_id"":null,""includes_external_attendees"":false,""app_call_id"":null,""is_demo"":true,""team_id"":8191429,""app_name"":""Zoom"",""document_chunks_dispatched"":{""transcript"":{""count"":1