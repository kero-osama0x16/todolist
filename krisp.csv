ngs/prod/user_15395451/team_8191429/01a1160be52473fa855f00ae7ff8b9eb/01a1160be52473fa855f00ae7ff8b9eb.pre-correction.json"",""processor"":""on_device"",""is_rated"":0,""user_id"":15395451,""variant"":""original"",""method"":""native"",""created_at"":""2026-10-07T11:07:22.460Z"",""status"":""uploaded"",""mime_type"":""text/plain"",""size"":3802,""updated_at"":""2026-10-07T11:07:25+00:00"",""correction_status"":""ready"",""workspace_id"":7114804,""language"":""en"",""max_spoken_language_code"":null,""version"":2,""speech_data"":[{""speakerIndex"":2,""id"":1,""speech"":{""start"":0,""end"":0.9600000000000009,""text"":""Hello."",""confidence"":[0.999],""wordStartTime"":[0]}},{""speakerIndex"":1,""id"":2,""speech"":{""start"":0.9600000000000009,""end"":2.24,""text"":""Hi."",""confidence"":[0.964],""wordStartTime"":[0.9600000000000009]}},{""speakerIndex"":2,""id"":2,""speech"":{""start"":2.24,""end"":6.480000000000002,""text"":""It's great that you're here. I'll now tell you about the important features of Krisp."",""confidence"":[0.997,1,0.999,0.98,0.999,0.978,0.973,1,1,1,0.999,0.999,0.964,0.999,0.9],""wordStartTime"":[2.24,2.5600000000000005,2.8000000000000007,2.960000000000001,3.280000000000001,3.7600000000000016,4.08,4.320000000000002,4.5600000000000005,4.8000000000000025,5.040000000000001,5.279999999999999,5.6800000000000015,6.160000000000002,6.320000000000002]}},{""speakerIndex"":1,""id"":1,""speech"":{""start"":7.4399999999999995,""end"":10.800000000000002,""text"":""Wow, I'm so excited. Tell me everything, you know."",""confidence"":[0.906,0.982,0.999,0.999,1,0.999,0.999,1,1],""wordStartTime"":[7.4399999999999995,8.000000000000002,8.320000000000002,8.72,9.520000000000001,9.840000000000002,10.08,10.480000000000002,10.72]}},{""speakerIndex"":2,""id"":4,""speech"":{""start"":12.640000000000002,""end"":32,""text"":""Well, Krisp automatically transcribes and records your meetings and then uses AI to create a short summary that you can share with your colleagues immediately after this meeting so you no longer have to spend hours crafting that follow up email with meeting notes and action items. Everything is done automatically."",""confidence"":[0.991,0.91,0.999,0.942,0.998,0.889,0.997,0.978,0.999,0.999,0.979,0.849,0.998,0.998,0.996,0.999,0.998,0.995,0.999,0.998,0.999,0.999,0.996,0.565,0.999,0.999,0.987,0.803,1,0.999,0.999,1,0.999,1,0.997,0.998,0.998,0.994,0.999,0.934,0.952,0.933,0.973,0.991,0.915,0.997,0.912,0.999,0.995,0.999,0.997],""wordStartTime"":[12.640000000000002,13.28,13.76,14.56,15.360000000000001,15.680000000000001,16.08,16.32,16.800000000000004,16.96,17.200000000000003,17.68,18.32,18.4,18.72,18.96,19.28,19.92,20.08,20.240000000000002,20.479999999999997,20.72,20.879999999999995,21.119999999999997,21.68,22.4,22.64,22.879999999999995,23.839999999999996,24.560000000000002,25.119999999999997,25.28,25.68,25.92,26.08,26.479999999999997,26.96,27.519999999999996,27.68,28,28.240000000000002,28.560000000000002,28.799999999999997,29.199999999999996,29.519999999999996,29.6,29.92,30.560000000000002,30.879999999999995,31.119999999999997,31.36]}},{""speakerIndex"":1,""id"":5,""speech"":{""start"":33.12,""end"":39.839999999999996,""text"":""This is really great. I want to use it right now. But does it what, with my calling app?"",""confidence"":[0.998,0.999,0.999,0.999,1,0.815,0.803,0.999,0.999,0.998,1,0.998,0.975,0.983,0.77,0.955,0.998,0.963,0.814],""wordStartTime"":[33.12,33.28,33.6,33.92,34.32,34.64,34.8,34.96,35.199999999999996,35.44,35.76,37.44,38.16,38.4,38.56,38.72,39.04,39.199999999999996,39.68]}},{""speakerIndex"":2,""id"":6,""speech"":{""start"":41.12,""end"":50.64,""text"":""Yes, and that's the best part. Krisp works with any calling app, so you can use it across all the calling applications and centralize your meetinging knowledge."",""confidence"":[0.991,0.989,0.993,0.999,1,0.999,0.279,0.997,0.999,0.997,0.375,0.975,0.997,0.997,0.994,1,0.998,1,0.999,0.999,0.922,0.997,0.999,0.997,0.997,0.655,0.988],""wordStartTime"":[41.12,41.44,41.6,41.92,42.08,42.48,43.12,43.839999999999996,44.16,44.4,44.72,45.12,45.519999999999996,45.6,45.76,45.92,46.08,46.4,46.72,46.96,47.12,47.68,48.48,48.8,49.519999999999996,49.68,50.32]}},{""speakerIndex"":1,""id"":7,""speech"":{""start"":51.68,""end"":55.28,""text"":""Thank you so much. I'm so excited to go and try this out."",""confidence"":[1,0.999,0.999,0.999,0.991,0.997,0.999,1,0.998,0.994,0.999,0.999,0.995],""wordStartTime"":[51.68,51.92,52.31999999999999,52.64,53.03999999999999,53.36,53.67999999999999,54.16,54.239999999999995,54.480000000000004,54.72,55.03999999999999,55.2]}},{""speakerIndex"":2,""id"":8,""speech"":{""start"":56.08,""end"":61.760000000000005,""text"":""You're welcome. Just make sure that Krisp is up and running in your next meeting and see it for yourself."",""confidence"":[0.97,0.998,0.997,1,1,0.997,0.782,0.97,1,0.999,0.999,0.995,0.997,1,1,0.998,0.635,0.591,0.999,0.999],""wordStartTime"":[56.08,56.480000000000004,57.120000000000005,57.28,57.519999999999996,57.67999999999999,57.92,58.480000000000004,58.64,58.8,58.879999999999995,59.44,59.599999999999994,59.760000000000005,60.08,60.56,60.879999999999995,61.120000000000005,61.36,61.519999999999996]}}],""eng_confidence"":96.15384615384616,""meta"":{""version"":2,""eng_confidence"":96.15384615384616},""content"":""[{\""speakerIndex\"":2,\""id\"":1,\""speech\"":{\""start\"":12.027,\""end\"":12.987,\""text\"":\""Hello.\"",\""confidence\"":[0.999],\""wordStartTime\"":[12.027]}},{\""speakerIndex\"":1,\""id\"":2,\""speech\"":{\""start\"":12.987,\""end\"":14.267,\""text\"":\""Hi.\"",\""confidence\"":[0.964],\""wordStartTime\"":[12.987]}},{\""speakerIndex\"":2,\""id\"":2,\""speech\"":{\""start\"":14.267,\""end\"":18.507,\""text\"":\""It's great that you're here. I'll now tell you about the important features of Krisp.\"",\""confidence\"":[0.997,1,0.999,0.98,0.999,0.978,0.973,1,1,1,0.999,0.999,0.964,0.999,0.9],\""wordStartTime\"":[14.267,14.587,14.827,14.987,15.307,15.787,16.107,16.347,16.587,16.827,